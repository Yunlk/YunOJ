# 复制为 .env 后按需修改（docker compose 会自动读取）
# 数据库密码
POSTGRES_PASSWORD=yunoj
# 生产部署改为 production；此时弱 JWT 密钥会阻止服务启动
APP_ENV=development
# JWT 签名密钥，生产环境务必改为足够长的随机串（如 openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me
# 直接跨域调用 API 的来源白名单，多个来源以逗号分隔；同源部署可留空
CORS_ALLOWED_ORIGINS=
# 单节点初始并发（首次注册后由集群管理页接管）
JUDGE_WORKERS=2
# 节点版本标识
JUDGE_VERSION=dev
# 前端公开端口（本机 8080 被 NI Application Web Server 占用，故默认 8090）
HTTP_PORT=8090
# backend 与 judge 共用的自定义语言配置
LANGUAGE_CONFIG=./config/languages.json
# cgroup 精确内存计量：裸 Linux 服务器设 true；WSL2/Docker Desktop 视内核委派情况
ISOLATE_CG=false
# 基础镜像前缀：留空走 Docker Hub（WSL Arch 已配 registry-mirrors，见 README）；
# 需要强制指定镜像站时填 docker.1ms.run/ 这类前缀
REGISTRY_PREFIX=
