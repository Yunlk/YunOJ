# 复制为 .env 后按需修改（docker compose 会自动读取）
# 数据库密码
POSTGRES_PASSWORD=yunoj
# JWT 签名密钥，生产环境务必改为足够长的随机串（如 openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me
# 单节点初始并发（首次注册后由集群管理页接管）
JUDGE_WORKERS=2
# 节点版本标识
JUDGE_VERSION=dev
# 前端公开端口
HTTP_PORT=8080
# backend 与 judge 共用的自定义语言配置
LANGUAGE_CONFIG=./config/languages.json
# cgroup 精确内存计量：裸 Linux 服务器设 true；Docker Desktop/WSL2 保持 false
ISOLATE_CG=false
# 基础镜像前缀：国内默认 docker.1ms.run 加速；海外环境设为空
REGISTRY_PREFIX=docker.1ms.run/
